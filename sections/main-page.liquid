<style>
  #shopify-section-{{ section.id }} {
    --page-max-width: {{ section.settings.content_width }};
  }
</style>

<div class="container">
  <div class="page-spacer">
    <div class="page">
      <h1 class="h1 text-center">{{ page.title }}</h1>

      {%- if page.content != empty -%}
        <div class="prose">
          {%- comment -%}
            Impact core override: legacy brand cleanup at render time. Some page bodies still name Pokeseller14, and
            fixing them at the source means editing every page in the admin.

            The contact address deliberately stays pokeseller14@gmail.com (decision of 28/07/2026, reconfirmed on
            30/07/2026): the contact@vcollect.fr mailbox does not receive mail yet. Since the address contains the brand
            name, it is tokenised before the brand replaces run and restored afterwards, otherwise it would be rewritten
            to VCOLLECT@gmail.com. Remove these filters once the page contents are fixed in admin.
          {%- endcomment -%}
          {{ page.content | replace: 'Pokeseller14@gmail.com', '@@contact-email@@' | replace: 'pokeseller14@gmail.com', '@@contact-email@@' | replace: 'Pokeseller14', 'VCOLLECT' | replace: 'pokeseller14', 'VCOLLECT' | replace: '@@contact-email@@', 'pokeseller14@gmail.com' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "class": "shopify-section--main-page",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "60ch",
          "label": "Small"
        },
        {
          "value": "80ch",
          "label": "Medium"
        },
        {
          "value": "100ch",
          "label": "Large"
        },
        {
          "value": "120ch",
          "label": "X-Large"
        },
        {
          "value": "100%",
          "label": "Full width"
        }
      ],
      "default": "80ch"
    }
  ]
}
{% endschema %}