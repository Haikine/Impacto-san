      {
        "type": "image_picker",
        "id": "social_sharing_image",
        "label": "Image",
        "info": "Custom (not Impact): used as the og:image / Twitter card image on pages without their own featured image (homepage, cart, generic pages). Prevents the shared preview from falling back to the shop-level social image. 1200 x 630px recommended."
      }
    ]
  },
  {
    "name": "Entity and SEO",
    "settings": [
      {
        "type": "header",
        "content": "Structured data identity"
      },
      {
        "type": "paragraph",
        "content": "Custom (not Impact). These values feed the Organization node emitted by snippets/structured-data.liquid on every page. They are the facts search engines and generative engines use to recognise the shop as one single, citable entity. Leave a field empty and the corresponding key is simply not emitted: never fill one with a guess."
      },
      {
        "type": "text",
        "id": "entity_alternate_name",
        "label": "Former or alternate name",
        "default": "Pokeseller14",
        "info": "The bridge between the old identity and the current one. This is what lets an engine connect the former name's reputation to this site instead of treating it as an unknown new shop."
      },
      {
        "type": "text",
        "id": "entity_legal_name",
        "label": "Registered company name",
        "default": "POKESELLER14",
        "info": "Exactly as filed at the company register. Must match the \"À propos\" page."
      },
      {
        "type": "text",
        "id": "entity_siren",
        "label": "Company registration number (SIREN)",
        "default": "948316401",
        "info": "Verified at the company register on 30/07/2026. Emitted as a schema.org identifier and displayed on the \"À propos\" page, from this single field, so the two can never disagree."
